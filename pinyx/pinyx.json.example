          "context_window": 200000,
          "max_tokens": 16384,
          "cost": { "input": 3.0, "output": 15.0, "cache_read": 0.3, "cache_write": 3.75 }
        },
        {
          "id": "claude-haiku-4-20250414",
          "name": "Claude Haiku 4",
          "reasoning": true,
          "input": ["text", "image"],
